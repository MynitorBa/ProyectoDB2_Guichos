# Copiar a backend/.env.demo solo en una máquina con recursos suficientes.
TIENDAYA_DEMO=true
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3317
MYSQL_DB=tiendaya_demo
MYSQL_USER=tiendaya_demo
MYSQL_PASSWORD=
MONGO_URI=mongodb://tiendaya_api:@127.0.0.1:27117/tiendaya_demo?authSource=tiendaya_demo
MONGO_DB=tiendaya_demo
REDIS_HOST=127.0.0.1
REDIS_PORT=6389
REDIS_USERNAME=tiendaya_api
REDIS_PASSWORD=
CASSANDRA_HOST=127.0.0.1
CASSANDRA_PORT=9142
CASSANDRA_KEYSPACE=tiendaya_analytics_demo
NEO4J_URI=bolt://127.0.0.1:7787
NEO4J_USER=neo4j
NEO4J_PASSWORD=
ES_URL=http://127.0.0.1:9210
ES_INDEX_ALIAS=productos_demo
ES_USERNAME=tiendaya_api
ES_PASSWORD=
FRONTEND_URL=http://localhost:5175
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8005
PAYMENT_GATEWAY_URL=http://127.0.0.1:8006
# La DEMO nunca envía correos reales ni habilita inyección de fallas.
SMTP_USER=
SMTP_PASSWORD=
FAULT_INJECTION_ENABLED=false
FRAUD_ANALYSIS_ENABLED=false
FRAUD_ANALYSIS_INTERVAL_SECONDS=3600
SECRET_KEY=
# ── Control de acceso (Entrega final) ─────────────────────────────────────────
# Vacías a propósito: scripts/configurar-acceso-demo.ps1 las genera (o adopta las
# de contenedores DEMO ya creados) y completa las del backend de arriba.
DEMO_MYSQL_ROOT_PASSWORD=
DEMO_MYSQL_PASSWORD=
DEMO_MONGO_PASSWORD=
DEMO_NEO4J_PASSWORD=
DEMO_REDIS_API_PASSWORD=
DEMO_REDIS_LECTURA_PASSWORD=
DEMO_REDIS_ADMIN_PASSWORD=
DEMO_MONGO_API_PASSWORD=
DEMO_MONGO_LECTURA_PASSWORD=
DEMO_MONGO_ADMIN_PASSWORD=
DEMO_ELASTIC_PASSWORD=
DEMO_ES_API_PASSWORD=
DEMO_ES_INDEXADOR_PASSWORD=
DEMO_ES_LECTURA_PASSWORD=
