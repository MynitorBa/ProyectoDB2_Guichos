# ── MySQL ──────────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=tiendaya
MYSQL_USER=tiendaya
MYSQL_PASSWORD=tiendaya123
MYSQL_PORT=3307

# ── MongoDB ────────────────────────────────────────────────────────────────────
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=adminpassword
MONGO_DATABASE=tiendaya
# Usuarios por servicio (database/mongo/03_usuarios.js). Vacías a propósito:
# scripts/generar-credenciales.ps1 las genera al azar la primera vez.
MONGO_API_PASSWORD=
MONGO_LECTURA_PASSWORD=
MONGO_ADMIN_PASSWORD=

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_CART_TTL=1800
# Control de acceso (database/redis/acl.conf). Vacías a propósito:
# scripts/generar-credenciales.ps1 las genera al azar la primera vez.
REDIS_API_PASSWORD=
REDIS_LECTURA_PASSWORD=
REDIS_ADMIN_PASSWORD=

# ── Cassandra (analítica de ventas) ──────────────────────────────────────────
CASSANDRA_HOST=localhost
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=tiendaya_analytics
CASSANDRA_LOCAL_DC=datacenter1

# ── Elasticsearch (búsqueda de productos) ────────────────────────────────────
ES_URL=http://127.0.0.1:9200
ES_INDEX_ALIAS=productos
# Control de acceso (database/elasticsearch/seguridad.json). Vacías a propósito:
# scripts/generar-credenciales.ps1 las genera al azar la primera vez.
ELASTIC_PASSWORD=
ES_API_PASSWORD=
ES_INDEXADOR_PASSWORD=
ES_LECTURA_PASSWORD=

# ── Backend ────────────────────────────────────────────────────────────────────
BACKEND_HOST=localhost
BACKEND_PORT=8000
